# Copia este archivo a .env.local para desarrollar contra Supabase.
# Sin estas dos variables la aplicación arranca en MODO DEMOSTRACIÓN: datos del caso
# ficticio CE-INV guardados solo en tu navegador.
#
# Se aceptan con prefijo VITE_ o NEXT_PUBLIC_ (las que ya existen en Netlify sirven).
# Solo van claves PUBLICABLES: todo lo que lleva estos prefijos termina en el navegador.
# La clave secreta (service_role) NUNCA va aquí.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
