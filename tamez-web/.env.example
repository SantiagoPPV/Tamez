# =============================================================================
# TAMEZ Plastic Surgery — variables de entorno
#
# LOCAL:   copia este archivo a `.env.local` y rellena los valores.
#          `.env.local` está en .gitignore y NUNCA debe subirse al repositorio.
#
# NETLIFY: Site configuration → Environment variables. Añade las mismas claves.
#          Marca SUPABASE_SECRET_KEY como "secret" (valor oculto).
#
# ⚠️ EL PREFIJO ES `NEXT_PUBLIC_`, NO `VITE_`.
#    Esto es Next.js. Una variable `VITE_SUPABASE_URL` no la lee nadie y el
#    fallo es silencioso: el build pasa y el formulario responde
#    "not_configured" sin dejar rastro en el log.
# =============================================================================

# --- Sitio -------------------------------------------------------------------
# URL pública final. Determina canonical, Open Graph y sitemap.
# En Netlify, antes de conectar el dominio, usa la URL *.netlify.app.
NEXT_PUBLIC_SITE_URL=https://tamezplasticsurgery.com

# --- Supabase ----------------------------------------------------------------
# Supabase Dashboard → Project Settings → API

# URL del proyecto (pública).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave publicable / anon (pública, segura en el navegador).
# Los proyectos nuevos entregan una clave con prefijo `sb_publishable_...`;
# los antiguos, un JWT `anon`. Cualquiera de las dos variables funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave SECRETA de servidor (service_role). Omite RLS: nunca la expongas.
# NO le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Contacto ----------------------------------------------------------------
# Número de WhatsApp con código de país, sólo dígitos. Ej. México: 5281XXXXXXXX
# Mientras esté vacío, el sitio muestra el marcador [PENDIENTE: WhatsApp]
# en lugar de un enlace roto.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Analítica (opcional) ----------------------------------------------------
# ID de Google Analytics 4 de la cuenta del cliente. Si está vacío, no se
# carga ningún script de terceros.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Anti-spam (opcional) ----------------------------------------------------
# Cadena aleatoria usada como sal al hashear la IP de los envíos.
# Genera una con: openssl rand -hex 16
LEAD_IP_SALT=
